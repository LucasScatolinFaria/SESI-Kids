{
  "expo": {
    "name": "SESI Kids",
    "slug": "sesikids",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B0E52"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3A1C9C"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "SESI Kids",
      "shortName": "SESI Kids",
      "lang": "pt-BR",
      "description": "Jogos educativos para aprender brincando: memória, matemática, palavras, quiz, lógica e reflexo.",
      "themeColor": "#3A1C9C",
      "backgroundColor": "#1B0E52"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-asset"
    ]
  }
}
